---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getSortedModules, getModulePage, getModulesWithTitles, slugFor } from '../../lib/labModules';

export async function getStaticPaths() {
  const entries = await getSortedModules('lab02Modules');
  return entries.map((entry) => ({
    params: { slug: slugFor(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, title } = await getModulePage(entry);
const modules = await getModulesWithTitles('lab02Modules');
---
<DocsLayout title={title} lab="lab02" labTitle="Lab 02" modules={modules} current={slugFor(entry)}>
  <Content />
</DocsLayout>
