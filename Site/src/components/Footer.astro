---
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="inner">
    <p>
      <strong>Global AI Community — Pune</strong> · August 22, 2026 · Organized by Pune Tech Community
    </p>
    <p class="links">
      <a href={base}>Home</a>
      <a href="https://github.com/Pune-Tech-Community/Global-AI-Construct-2026" target="_blank" rel="noopener noreferrer">
        Source on GitHub
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 3rem;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.75rem 1.5rem 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    color: var(--slate);
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    gap: 1.25rem;
  }

  .links a {
    color: var(--slate);
  }

  .links a:hover {
    color: var(--blue);
  }

  p {
    margin: 0;
  }
</style>
